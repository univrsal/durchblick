uniform float4x4 ViewProj;
uniform float volume;
uniform float4 background_nominal;
uniform float4 background_warning;
uniform float4 background_error;
uniform float4 foreground_nominal;
uniform float4 foreground_warning;
uniform float4 foreground_error;

struct VertData {
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
};

VertData VSVolume(VertData vd)
{
	VertData vert_out;
	vert_out.pos = mul(float4(vd.pos.xyz, 1.0), ViewProj);
	vert_out.uv = vd.uv;
	return vert_out;
}

float4 PSVolume(VertData vd) : TARGET
{
    const float error_end = 0.15;
    const float warning_end = 0.3333333333;
    bool active = vd.uv.y >= 1.0 - volume;

    if (vd.uv.y < error_end)
        return active ? foreground_error : background_error;
    if (vd.uv.y < warning_end)
        return active ? foreground_warning : background_warning;
    return active ? foreground_nominal : background_nominal;
}

technique Solid
{
	pass
	{
		vertex_shader = VSVolume(vd);
		pixel_shader  = PSVolume(vd);
	}
}
